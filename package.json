{
  "name": "kevin-learning-home",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.15.0",
    "npm": "11.12.1"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "vite build --config apps/web/vite.config.ts",
    "typecheck": "tsc --noEmit",
    "start": "node apps/server/main.ts",
    "test": "node --test --test-concurrency=1 tests/foundation/*.test.ts",
    "test:browser": "node tests/foundation/browser-smoke.ts",
    "test:container": "node tests/foundation/container-smoke.ts",
    "migrate": "node scripts/maintenance.ts migrate",
    "seed:synthetic": "node scripts/maintenance.ts seed --synthetic",
    "backup": "node scripts/maintenance.ts backup",
    "restore": "node scripts/maintenance.ts restore",
    "verify": "npm run typecheck && npm run build && npm test && npm run test:browser"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "prettier": "3.9.10",
    "typescript": "7.0.2",
    "vite": "8.3.4"
  }
}
