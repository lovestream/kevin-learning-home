{
  "name": "kevin-learning-home",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.15.0",
    "npm": "11.12.1"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "node scripts/math01/seal.ts && vite build --config apps/web/vite.config.ts && node scripts/math01/build.ts",
    "typecheck": "tsc --noEmit",
    "start": "node apps/server/main.ts",
    "test": "node --test --test-concurrency=1 tests/foundation/*.test.ts tests/auth/*.test.ts tests/shell/*.test.ts",
    "test:browser": "node tests/foundation/browser-smoke.ts",
    "test:container": "node tests/foundation/container-smoke.ts",
    "migrate": "node scripts/maintenance.ts migrate",
    "seed:synthetic": "node scripts/maintenance.ts seed --synthetic",
    "backup": "node scripts/maintenance.ts backup",
    "restore": "node scripts/maintenance.ts restore",
    "verify": "node scripts/verify.ts",
    "test:ui": "node tests/shell/browser.ts",
    "test:auth": "node --test --test-concurrency=1 tests/auth/*.test.ts",
    "auth:admin": "node scripts/auth-admin.ts",
    "test:math01": "node --test --test-concurrency=1 tests/math01/*.test.ts",
    "test:math01:browser": "node tests/math01/browser.ts",
    "build:math-preview": "vite build --config apps/preview/vite.config.ts && node scripts/math-full-01/build.ts",
    "preview:math": "KLH_CONTENT_PREVIEW=1 node apps/preview/server.ts"
  },
  "dependencies": {
    "fs-ext": "2.1.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/fs-ext": "2.0.3",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "lucide-react": "0.468.0",
    "prettier": "3.9.10",
    "typescript": "7.0.2",
    "vite": "8.3.4"
  }
}
